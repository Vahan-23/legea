# Публичный URL сайта (без слэша в конце).
# Обязателен в production — от него зависят canonical, hreflang, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — отправка заявок и спецификаций на email менеджера.
# 1. Зарегистрируйтесь на https://resend.com
# 2. Создайте API Key → RESEND_API_KEY
# 3. Добавьте домен и подтвердите DNS → RESEND_FROM (например noreply@yourdomain.com)
# 4. Укажите email менеджера → MANAGER_EMAIL
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
MANAGER_EMAIL=manager@example.com
# Опционально — копия письма
MANAGER_EMAIL_CC=
